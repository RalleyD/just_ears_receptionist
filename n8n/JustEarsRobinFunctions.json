      "id": "8c607e27-acdf-4bba-9871-abab7b6ff956",
      "name": "Check Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        1712,
        5808
      ],
      "typeVersion": 1.2,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "O4fEgdyuxvLl4vg2",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requestData = $('Parse Availability Request').first().json\nconst calendarEvents = $input.all();\n\n// gives us the requested date time in a locale string format, hopefully GMT london if we have the calendar and workflow setup correctly!\n// const requestedDate = new Date(requestData).toString();\n// get the requested time window, UTC format\nconst requestedStart = new Date(requestData.timeMin);\nconst requestedEnd = new Date(requestData.timeMax);\n\n// Check if there are any conflicts - time overlap\nconst hasConflicts = calendarEvents.filter(\n  item => {\n    if (!item.json.start?.dateTime) return false;\n\n    const eventStart = new Date(item.json.start.dateTime);\n    const eventEnd = new Date(item.json.end.dateTime);\n\n    // conflict occurs if event starts before slot ends AND event ends after slot starts\n    return eventStart < requestedEnd && eventEnd > requestedStart;\n  }\n)\n.map(item => ({\n  start: item.json.start.dateTime,\n  end: item.json.end.dateTime,\n  summary: item.json.summary || 'Busy'\n}));\n\nif (hasConflicts.length > 0) {\n  // Slot is unavailable\n  return {\n    json: {\n      available: false,\n      requested_slot: {\n        date: requestData.date,\n        time: requestData.time,\n        duration: requestData.duration\n      },\n      conflicts: hasConflicts\n    }\n  };\n} else {\n  // Slot is available\n  return {\n    json: {\n      available: true,\n      requested_slot: {\n        date: requestData.date,\n        time: requestData.time,\n        duration: requestData.duration\n      }\n    }\n  };\n}"
      },
      "id": "ebbc4faf-2d60-474a-a1b3-589c35fec6ad",
      "name": "Format Availability Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1904,
        5808
      ],
      "typeVersion": 2
    },
