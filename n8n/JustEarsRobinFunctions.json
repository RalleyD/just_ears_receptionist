        "jsCode": "const topic = $('Parse Info Request').item.json.topic;\nconst htmlContent = $input.item.json.data;\n\n// Simple HTML tag removal (for better extraction, consider using a library)\nlet textContent = htmlContent\n  .replace(/<script[^>]*>([\\S\\s]*?)<\\/script>/gi, '')\n  .replace(/<style[^>]*>([\\S\\s]*?)<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// Limit content length (max 2000 characters for voice responses)\nif (textContent.length > 5000) {\n  textContent = textContent.substring(0, 5000) + '...';\n}\n\nreturn {\n  json: {\n    topic: topic,\n    content: textContent\n  }\n};"
