      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nreturn {\n  json: {\n    patient_name: body.patient_name,\n    phone: body.phone,\n    patient_email: body.patient_email || '',\n    appointment_type: body.appointment_type,\n    start_datetime: body.start_datetime,\n    end_datetime: body.end_datetime,\n    location: body.location,\n    notes: body.notes || ''\n  }\n};"
      },
      "id": "b40ffd35-25cb-41a3-ab04-841e841b9ab7",
      "name": "Parse Appointment Request",
      "type": "n8n-nodes-base.code",
      "position": [
        1504,
        6032
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const requestData = $('Parse Appointment Request').item.json;\nconst calendarEvent = $input.item.json;\n\n// Parse datetime for friendly format\nconst startDate = new Date(requestData.start_datetime);\nconst options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\nconst formattedDate = startDate.toLocaleDateString('en-GB', options);\nconst formattedTime = startDate.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });\n\n// Calculate duration\nconst endDate = new Date(requestData.end_datetime);\nconst durationMinutes = (endDate - startDate) / 1000 / 60;\n\nconst confirmation = `Appointment booked for ${requestData.patient_name} on ${formattedDate} at ${formattedTime} at ${requestData.location} for ${requestData.appointment_type} (${durationMinutes} minutes).`;\n\nreturn {\n  json: {\n    success: true,\n    event_id: calendarEvent.id,\n    confirmation: confirmation\n  }\n};"
      },
