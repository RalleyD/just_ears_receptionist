    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\n// Extract request parameters\nconst appointmentType = body.appointment_type;\nconst date = body.date;\nconst time = body.time;\nconst durationMinutes = body.duration_minutes;\nconst location = body.location;\n\n// Parse date and time\nconst [year, month, day] = date.split('-');\nconst [hour, minute] = time.split(':');\n\n// Create start datetime\nconst startDateTime = new Date(year, month - 1, day, hour, minute);\n\n// Create end datetime\nconst endDateTime = new Date(startDateTime);\nendDateTime.setMinutes(endDateTime.getMinutes() + durationMinutes);\n\n// Format for Google Calendar (ISO 8601)\nconst timeMin = startDateTime.toISOString();\nconst timeMax = endDateTime.toISOString();\n\nreturn {\n  json: {\n    appointment_type: appointmentType,\n    date: date,\n    time: time,\n    duration: durationMinutes,\n    location: location,\n    timeMin: timeMin,\n    timeMax: timeMax,\n    startDateTime: startDateTime.toISOString(),\n    endDateTime: endDateTime.toISOString()\n  }\n};"
      },
      "id": "5a738750-2d3f-456a-8b8c-577964e7eeb1",
      "name": "Parse Availability Request",
      "type": "n8n-nodes-base.code",
      "position": [
        1504,
        5808
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
